{
  "name": "ai-tutorial-build",
  "version": "1.0.0",
  "description": "AgentScope Java 2.0 中文教程构建工具链（Markdown → HTML → PDF）",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node build.mjs --check --book agentscope-java",
    "html": "node build.mjs --html --book agentscope-java",
    "pdf": "node build.mjs --pdf --book agentscope-java",
    "site": "node build.mjs --site && pagefind --site ../output/site",
    "test": "node --test books/books.test.mjs clean.test.mjs fetch-images.test.mjs site.test.mjs"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.2",
    "mermaid": "^12.1.0",
    "pagedjs": "^0.4.3"
  },
  "devDependencies": {
    "pagefind": "^1.5.2"
  }
}