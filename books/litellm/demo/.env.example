# 复制为 .env 后填写。不要提交 .env。下面的值都是占位，不能当成可用密钥。
# 本机实验用过的口令只存在于那台机器的 shell 里，没有写进仓库。

MOCK_UPSTREAM_KEY=sk-mock-upstream-replace-me
LITELLM_MASTER_KEY=sk-litellm-master-replace-me
LITELLM_SALT_KEY=sk-salt-replace-me
DATABASE_URL=postgresql://litellm:replace-me@127.0.0.1:5432/litellm

# 可选。未接真实 Langfuse 时留空，不要把回调开在没有密钥的配置上。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
