# 本地演示口令，和 docker-compose.yml 里写的是同一套。
# 复制成 .env 只在你要覆盖 compose 的默认值时才需要。compose 本身不读取这个文件。
# 这些值不是厂商密钥。不要换成真实的供应商钥匙，也不要设置 LITELLM_LICENSE。
# UI 登录用 UI_USERNAME / UI_PASSWORD。API 和 smoke.sh、seed.sh 用 LITELLM_MASTER_KEY。
# 密码里有 #，写进 shell 时加引号。

UI_USERNAME=admin
UI_PASSWORD="StarsailDemo#2026"
LITELLM_MASTER_KEY=sk-starsail-master
MOCK_UPSTREAM_KEY=sk-mock-upstream

# 容器内部已经用 db:5432。下面这一行是宿主机上的客户端要连发布出来的 5432 时用的。
DATABASE_URL=postgresql://llmproxy:dbpassword9090@127.0.0.1:5432/litellm

# 可选。未接真实 Langfuse 时留空，不要把回调开在没有密钥的配置上。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000
